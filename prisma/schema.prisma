generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}
datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------------
// Enums
// ------------------------------------------------------------


enum EnrollmentType {
  IN_PERSON
  INDEPENDENT_STUDY
}

enum EnrollmentStatus {
  ACTIVE
  DROPPED
  COMPLETED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum SemesterStatus {
  UPCOMING
  ACTIVE
  CLOSED
}

enum RsvpStatus {
  GOING
  MAYBE
  NOT_GOING
}

enum ClassCategory {
  CORNERSTONE
  GOSPEL
  SCRIPTURE
  OTHER
  SCRIPTURE_STUDY
  MISSIONARY_PREP
  INSTITUTE_FOUNDATIONS
}

enum CreditType {
  CORE
  ELECTIVE
}
enum Role {
  SUPER_ADMIN
  AREA_ADMIN
  STAKE_ADMIN
  COORDINATOR
  TEACHER
  STUDENT
}

// ------------------------------------------------------------
// Core identity
// ------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role

  // Sign-in protection: after 5 wrong passwords in a row the account waits 15 minutes
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  // Goes up when the password changes, which signs this account out on every other device
  sessionVersion   Int       @default(0)
  lastLoginAt      DateTime?
  // Set when an admin creates the account or resets its password: the person must
  // choose their own password before they can use IRMS
  mustChangePassword Boolean @default(false)

  // Stake admins and coordinators only see students of this stake (empty = not limited yet)
  stake            String?

  // Two-step sign-in with an authenticator app. The secret is stored encrypted;
  // recovery codes are stored only as hashes.
  totpSecret       String?
  totpEnabledAt    DateTime?
  totpLastStep     Int?
  recoveryCodes    String[]  @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student Student?
  teacher Teacher?

  announcementsAuthored Announcement[] @relation("AnnouncementAuthor")
  eventsCreated         Event[]        @relation("EventCreator")

  @@index([role])
}

model Student {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  user                   User     @relation(fields: [userId], references: [id])

  ward                   String?
  stake                  String?
  phone                  String?
  membershipRecordNumber String?
  occupation             String?
  school                 String?

  active                 Boolean  @default(true)

  enrollments            Enrollment[]
  attendanceRecords      Attendance[]
  graduationProgress     GraduationProgress?
  eventRsvps             EventRsvp[]

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model Teacher {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  phone     String?

  classes   Class[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Every sign-in attempt, by network address, so one address can't guess passwords
// across many accounts. Old rows are cleared automatically.
model LoginAttempt {
  id        String   @id @default(cuid())
  ip        String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
}

// Who did what, and when. Written by the app; never edited or deleted by it.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actorName String
  action    String
  summary   String
  targetId  String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([action])
}

// ------------------------------------------------------------
// Semester
// ------------------------------------------------------------

model Semester {
  id        String         @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  status    SemesterStatus @default(UPCOMING)

  classes   Class[]
  events    Event[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ------------------------------------------------------------
// Classes & Enrollment
// ------------------------------------------------------------

model Class {
  id         String        @id @default(cuid())
  name       String
  category   ClassCategory @default(SCRIPTURE_STUDY)
  creditType CreditType    @default(CORE)

  semesterId String
  semester   Semester      @relation(fields: [semesterId], references: [id])

  teacherId  String?
  teacher    Teacher?      @relation(fields: [teacherId], references: [id])

  dayOfWeek  Int?
  startTime  String?
  venue      String?
  capacity   Int?

  // Where the class actually meets, saved once from a phone in the room.
  // Check-ins are measured against this, so any device can run attendance.
  venueLatitude  Float?
  venueLongitude Float?
  venueAccuracy  Float?
  venueSavedAt   DateTime?
  archived   Boolean       @default(false)

  enrollments        Enrollment[]
  attendance         Attendance[]
  attendanceSessions AttendanceSession[]
  announcements      Announcement[]
  resources          Resource[]
  lessonPlans        LessonPlan[]

  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

model Enrollment {
  id         String           @id @default(cuid())

  studentId  String
  student    Student          @relation(fields: [studentId], references: [id])

  classId    String
  class      Class            @relation(fields: [classId], references: [id])

  type       EnrollmentType   @default(IN_PERSON)
  status     EnrollmentStatus @default(ACTIVE)

  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([studentId, classId])
}

// ------------------------------------------------------------
// Attendance + QR check-in sessions
// ------------------------------------------------------------

model AttendanceSession {
  id        String   @id @default(cuid())

  classId   String
  class     Class    @relation(fields: [classId], references: [id])

  date      DateTime
  token     String   @unique
  expiresAt DateTime
  latitude  Float?
  longitude Float?
  // How precise that position is, in metres (added to the distance students are allowed)
  accuracy  Float?

  createdAt DateTime @default(now())
}

model Attendance {
  id        String            @id @default(cuid())

  studentId String
  student   Student           @relation(fields: [studentId], references: [id])

  classId   String
  class     Class             @relation(fields: [classId], references: [id])

  date      DateTime
  status    AttendanceStatus

  verifiedById String?   // set when a teacher marked this by hand
  deviceId     String?   // which phone checked in (to spot one phone checking in two students)

  createdAt DateTime          @default(now())

  @@unique([studentId, classId, date])
  @@index([classId, date])
}

// ------------------------------------------------------------
// Graduation tracking
// ------------------------------------------------------------

model GraduationProgress {
  id                       String    @id @default(cuid())

  studentId                String    @unique
  student                  Student   @relation(fields: [studentId], references: [id])

  coreCreditsCompleted     Int       @default(0)
  coreCreditsRequired      Int       @default(2)
  electiveCreditsCompleted Int       @default(0)
  electiveCreditsRequired  Int       @default(2)

  graduated                Boolean   @default(false)
  graduationDate           DateTime?

  updatedAt                DateTime  @updatedAt
}

// ------------------------------------------------------------
// Announcements
// ------------------------------------------------------------

model Announcement {
  id         String   @id @default(cuid())
  title      String
  body       String

  authorId   String
  author     User     @relation("AnnouncementAuthor", fields: [authorId], references: [id])

  classId    String?
  class      Class?   @relation(fields: [classId], references: [id])

  targetStake String?

  createdAt  DateTime @default(now())
}

// ------------------------------------------------------------
// Events & RSVP
// ------------------------------------------------------------

model Event {
  id         String      @id @default(cuid())
  title      String
  description String?
  date       DateTime
  venue      String?

  semesterId String?
  semester   Semester?   @relation(fields: [semesterId], references: [id])

  createdById String
  createdBy   User        @relation("EventCreator", fields: [createdById], references: [id])

  rsvps      EventRsvp[]

  createdAt  DateTime    @default(now())
}

model EventRsvp {
  id        String     @id @default(cuid())

  studentId String
  student   Student    @relation(fields: [studentId], references: [id])

  eventId   String
  event     Event      @relation(fields: [eventId], references: [id])

  status    RsvpStatus @default(GOING)

  createdAt DateTime   @default(now())

  @@unique([studentId, eventId])
}

// ------------------------------------------------------------
// Resource Library
// ------------------------------------------------------------

model Resource {
  id        String   @id @default(cuid())
  title     String
  fileUrl   String

  classId   String
  class     Class    @relation(fields: [classId], references: [id])

  uploadedById String

  createdAt DateTime @default(now())

  // LINK (Drive, YouTube, a website) or FILE (uploaded, kept in ResourceFile)
  kind        String  @default("LINK")
  description String?
  fileName    String?
  mimeType    String?
  size        Int?
  file        ResourceFile?
}

// The bytes of an uploaded file, kept apart so lists of materials stay fast
model ResourceFile {
  resourceId String   @id
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  data       Bytes
}

// A teacher's plan for one lesson. Students only see plans marked "shared".
model LessonPlan {
  id          String    @id @default(cuid())
  classId     String
  class       Class     @relation(fields: [classId], references: [id])
  date        DateTime?
  title       String
  scriptures  String?
  objectives  String?
  activities  String?
  notes       String?
  status      String    @default("DRAFT") // DRAFT, READY, TAUGHT
  shared      Boolean   @default(false)
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([classId, date])
}